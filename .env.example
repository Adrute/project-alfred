NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
HOST=127.0.0.1
PORT=3000

# Preferred model when it is available in the connected ChatGPT account.
CHATGPT_MODEL=gpt-6.1-sol
# En una instancia HTTPS, configura el ID de un cliente OAuth público registrado
# por OpenAI con APP_ORIGIN/auth/callback como URL de retorno exacta.
# El cliente debe tener autorizado chatgpt.tokens.use.direct para usar el plan.
CHATGPT_OAUTH_CLIENT_ID=

# Prisma SQLite URL. Relative file URLs are resolved by Prisma from prisma.config.ts.
DATABASE_URL=file:./data/alfred.db
DATA_DIRECTORY=./data
LOG_LEVEL=info
