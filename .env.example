NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
HOST=127.0.0.1
PORT=3000

# Only loopback Ollama endpoints are accepted.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_DEMO_MODE=false

# Prisma SQLite URL. Relative file URLs are resolved by Prisma from prisma.config.ts.
DATABASE_URL=file:./data/alfred.db
DATA_DIRECTORY=./data
LOG_LEVEL=info
