NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
CLOUD_AI_ENABLED=true

# ChatGPT es el único proveedor de razonamiento generativo. Cambia el interruptor
# a false únicamente para cortar de inmediato toda comunicación cloud.
CHATGPT_MODEL=gpt-6.1-sol
# Solo para un cliente OAuth web autorizado por OpenAI con APP_ORIGIN/auth/callback.
# La vía normal para una VPS autohospedada es autorizar en el Mac y transferir
# la credencial protegida según DEPLOYMENT.md; deja esta variable vacía.
CHATGPT_OAUTH_CLIENT_ID=
# Solo para recuperar un cliente local registrado con la ruta histórica de callback.
# CHATGPT_LOCAL_CALLBACK_PATH=/api/auth/chatgpt/callback

# Prisma SQLite URL. Relative file URLs are resolved by Prisma from prisma.config.ts.
DATABASE_URL=file:./data/alfred.db
DATA_DIRECTORY=./data
LOG_LEVEL=info
