{
  "name": "alfred",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "fast-uri": "^3.1.9"
  },
  "scripts": {
    "auth:user": "node --import tsx scripts/manage-users.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "start:production": "node --import tsx scripts/start-production.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "agents:validate": "node --import tsx scripts/validate-development-agents.ts",
    "branch:check": "node --import tsx scripts/check-development-branch.ts",
    "ai:check": "node --import tsx scripts/check-chatgpt.ts",
    "ai:import-chatgpt": "node --import tsx scripts/import-chatgpt.ts",
    "ai:retire-chatgpt": "node --import tsx scripts/retire-chatgpt.ts",
    "ai:eval": "node --import tsx scripts/evaluate-assistant-model.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node --import tsx scripts/deploy-database.ts",
    "db:seed": "node --import tsx prisma/seed.ts",
    "demo:prepare": "npm run db:seed && node --import tsx scripts/prepare-demo.ts",
    "preview:capture": "node --import tsx scripts/capture-previews.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
