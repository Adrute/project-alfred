generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Local application identity. Teaching data remains shared between users.
model AppUser {
  id           String       @id @default(cuid())
  username     String       @unique
  displayName  String
  passwordHash String
  role         String       @default("user")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     AppSession[]
}

/// Only a one-way hash of the random browser session token is persisted.
model AppSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      AppUser   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Classroom {
  id                  String               @id @default(cuid())
  name                String
  academicYear        String
  educationalStage    String
  isTutorGroup        Boolean              @default(false)
  tutorNotes          String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  enrollments         StudentEnrollment[]
  seatingLayouts      SeatingLayout[]
  teachingAssignments TeachingAssignment[]

  @@unique([name, academicYear])
  @@index([academicYear])
}

model Subject {
  id          String               @id @default(cuid())
  name        String
  code        String               @unique
  color       String               @default("#315746")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  assignments TeachingAssignment[]

  @@index([name])
}

model TeachingAssignment {
  id             String                 @id @default(cuid())
  subjectId      String
  classroomId    String
  academicYear   String
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  subject        Subject                @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classroom      Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  timetableSlots TimetableSlot[]
  teachingUnits  TeachingUnit[]
  lessonPlans    LessonPlan[]
  studentRecords StudentSubjectRecord[]

  @@unique([subjectId, classroomId, academicYear])
  @@index([classroomId, active])
  @@index([subjectId, active])
}

model WeeklyTimetable {
  id           String          @id @default(cuid())
  name         String
  academicYear String
  timezone     String          @default("Europe/Madrid")
  validFrom    DateTime
  validUntil   DateTime?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  slots        TimetableSlot[]

  @@unique([name, academicYear])
  @@index([active, validFrom, validUntil])
}

model TimetableSlot {
  id                   String              @id @default(cuid())
  weeklyTimetableId    String
  teachingAssignmentId String
  dayOfWeek            Int
  startMinute          Int
  endMinute            Int
  activityType         String              @default("class")
  room                 String?
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  weeklyTimetable      WeeklyTimetable     @relation(fields: [weeklyTimetableId], references: [id], onDelete: Cascade)
  teachingAssignment   TeachingAssignment  @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  exceptions           PlanningException[]
  lessonPlans          LessonPlan[]

  @@unique([weeklyTimetableId, dayOfWeek, startMinute])
  @@index([teachingAssignmentId, dayOfWeek])
  @@index([active, dayOfWeek])
}

model PlanningException {
  id                  String        @id @default(cuid())
  timetableSlotId     String
  date                DateTime
  kind                String
  overrideStartMinute Int?
  overrideEndMinute   Int?
  reason              String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  timetableSlot       TimetableSlot @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)

  @@unique([timetableSlotId, date])
  @@index([date, kind])
}

model TeachingUnit {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  title                String
  description          String?
  objectives           String             @default("[]")
  sequenceOrder        Int
  estimatedSessions    Int
  status               String             @default("pending")
  plannedStartDate     DateTime?
  plannedEndDate       DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  contents             LearningContent[]
  lessonPlans          LessonPlan[]

  @@unique([teachingAssignmentId, sequenceOrder])
  @@index([teachingAssignmentId, status])
}

model LearningContent {
  id               String           @id @default(cuid())
  teachingUnitId   String
  title            String
  description      String?
  sequenceOrder    Int
  estimatedMinutes Int?
  status           String           @default("pending")
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  teachingUnit     TeachingUnit     @relation(fields: [teachingUnitId], references: [id], onDelete: Cascade)
  lessonActivities LessonActivity[]

  @@unique([teachingUnitId, sequenceOrder])
  @@index([teachingUnitId, status])
}

model LessonPlan {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  timetableSlotId      String?
  teachingUnitId       String?
  date                 DateTime
  startMinute          Int
  endMinute            Int
  title                String
  objectives           String             @default("[]")
  materials            String             @default("[]")
  homework             String?
  status               String             @default("unplanned")
  postLessonNotes      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  timetableSlot        TimetableSlot?     @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  teachingUnit         TeachingUnit?      @relation(fields: [teachingUnitId], references: [id], onDelete: SetNull)
  activities           LessonActivity[]
  executions           LessonExecution[]

  @@unique([timetableSlotId, date])
  @@index([date, startMinute])
  @@index([teachingAssignmentId, date])
  @@index([status, date])
}

model LessonActivity {
  id                String           @id @default(cuid())
  lessonPlanId      String
  learningContentId String?
  name              String
  description       String?
  durationMinutes   Int
  activityType      String
  sequenceOrder     Int
  executionStatus   String           @default("pending")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lessonPlan        LessonPlan       @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  learningContent   LearningContent? @relation(fields: [learningContentId], references: [id], onDelete: SetNull)

  @@unique([lessonPlanId, sequenceOrder])
  @@index([lessonPlanId, executionStatus])
  @@index([learningContentId])
}

model LessonExecution {
  id               String     @id @default(cuid())
  lessonPlanId     String
  status           String
  notes            String?
  activitySnapshot String
  confirmedAt      DateTime
  createdAt        DateTime   @default(now())
  lessonPlan       LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  @@index([lessonPlanId, confirmedAt])
}

model PlanningChange {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  changeType     String
  beforeSnapshot String?
  afterSnapshot  String
  createdAt      DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model Student {
  id                 String                 @id @default(cuid())
  firstName          String
  lastName           String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  enrollments        StudentEnrollment[]
  observations       StudentObservation[]
  relationshipsAsA   StudentRelationship[]  @relation("StudentA")
  relationshipsAsB   StudentRelationship[]  @relation("StudentB")
  tutoringSessions   TutoringSession[]
  teacherFeedbacks   TeacherFeedback[]
  seatingAssignments SeatingAssignment[]
  subjectRecords     StudentSubjectRecord[]

  @@index([firstName, lastName])
}

model StudentSubjectRecord {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  studentId            String
  progressStatus       String             @default("not_assessed")
  participationStatus  String             @default("not_assessed")
  homeworkStatus       String             @default("not_assessed")
  teacherNotes         String?
  supportNotes         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  student              Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grades               AssessmentGrade[]

  @@unique([teachingAssignmentId, studentId])
  @@index([studentId, updatedAt])
  @@index([teachingAssignmentId, progressStatus])
}

model AssessmentGrade {
  id               String               @id @default(cuid())
  studentRecordId  String
  title            String
  assessmentPeriod String
  score            Float
  maxScore         Float                @default(10)
  weight           Float                @default(1)
  assessedAt       DateTime
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  studentRecord    StudentSubjectRecord @relation(fields: [studentRecordId], references: [id], onDelete: Cascade)

  @@index([studentRecordId, assessmentPeriod])
  @@index([assessedAt])
}

model StudentEnrollment {
  id          String    @id @default(cuid())
  studentId   String
  classroomId String
  startDate   DateTime
  endDate     DateTime?
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([studentId, classroomId, startDate])
  @@index([classroomId, endDate])
  @@index([studentId, endDate])
}

model StudentObservation {
  id                 String   @id @default(cuid())
  studentId          String
  content            String
  category           String
  source             String
  observedAt         DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  confirmationStatus String   @default("confirmed")
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, observedAt])
  @@index([category, observedAt])
  @@index([confirmationStatus])
}

model StudentRelationship {
  id               String   @id @default(cuid())
  studentAId       String
  studentBId       String
  relationshipType String
  description      String
  source           String
  observedAt       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  active           Boolean  @default(true)
  studentA         Student  @relation("StudentA", fields: [studentAId], references: [id], onDelete: Cascade)
  studentB         Student  @relation("StudentB", fields: [studentBId], references: [id], onDelete: Cascade)

  @@index([studentAId, active])
  @@index([studentBId, active])
  @@index([relationshipType, active])
}

model TutoringSession {
  id               String              @id @default(cuid())
  studentId        String
  scheduledAt      DateTime?
  status           String              @default("draft")
  preparation      String?
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  agreements       TutoringAgreement[]
  teacherFeedbacks TeacherFeedback[]

  @@index([studentId, scheduledAt])
  @@index([status, scheduledAt])
}

model TeacherFeedback {
  id                  String           @id @default(cuid())
  studentId           String
  tutoringSessionId   String?
  teacherName         String?
  subject             String?
  originalComment     String
  familyVersion       String?
  familyVersionSource String?
  familyVersionStatus String           @default("proposed")
  receivedAt          DateTime         @default(now())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutoringSession     TutoringSession? @relation(fields: [tutoringSessionId], references: [id], onDelete: SetNull)

  @@index([studentId, receivedAt])
  @@index([tutoringSessionId])
  @@index([familyVersionStatus, receivedAt])
}

model TutoringAgreement {
  id                String          @id @default(cuid())
  tutoringSessionId String
  description       String
  status            String          @default("pending")
  dueDate           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  tutoringSession   TutoringSession @relation(fields: [tutoringSessionId], references: [id], onDelete: Cascade)

  @@index([tutoringSessionId, status])
  @@index([dueDate])
}

model Conversation {
  id                 String              @id @default(cuid())
  title              String
  contextJson        String              @default("{}")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  messages           Message[]
  agentConversations AgentConversation[]
  cloudAiTraces      CloudAiTrace[]

  @@index([updatedAt])
}

/// Local audit entry for one outbound cloud-AI request. Request bodies contain
/// the already-pseudonymized payload sent over the wire and never credentials.
model CloudAiTrace {
  id                String        @id @default(cuid())
  conversationId    String?
  agentId           String?
  provider          String        @default("openai-chatgpt")
  endpoint          String        @default("https://api.openai.com/v1/responses")
  operation         String        @default("llm_request")
  model             String
  status            String        @default("running")
  requestBodyJson   String
  responseBodyJson  String?
  responseId        String?
  requestId         String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  durationMs        Int?
  studentAliasCount Int           @default(0)
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime      @default(now())
  finishedAt        DateTime?
  conversation      Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([model, createdAt])
  @@index([operation, createdAt])
  @@index([agentId, createdAt])
  @@index([conversationId, createdAt])
}

/// Auditable A2A exchange for one Alfred orchestration request. It stores only
/// structured requests and final summaries, never hidden model reasoning.
model AgentConversation {
  id                 String         @id @default(cuid())
  requestId          String         @unique
  userConversationId String?
  title              String
  status             String         @default("running")
  createdAt          DateTime       @default(now())
  finishedAt         DateTime?
  userConversation   Conversation?  @relation(fields: [userConversationId], references: [id], onDelete: SetNull)
  messages           AgentMessage[]

  @@index([userConversationId, createdAt])
  @@index([status, createdAt])
}

/// One protocol-level request or response exchanged between Alfred and a
/// specialist agent inside the local process.
model AgentMessage {
  id                  String            @id @default(cuid())
  agentConversationId String
  protocol            String            @default("1.0")
  messageId           String            @unique
  fromAgentId         String
  toAgentId           String
  kind                String
  capability          String
  content             String
  payloadJson         String            @default("{}")
  createdAt           DateTime          @default(now())
  agentConversation   AgentConversation @relation(fields: [agentConversationId], references: [id], onDelete: Cascade)

  @@index([agentConversationId, createdAt])
  @@index([fromAgentId, toAgentId, createdAt])
  @@index([capability, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  agentId        String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AgentRuntime {
  agentId      String    @id
  status       String    @default("running")
  aiModel      String?
  startedAt    DateTime?
  stoppedAt    DateTime?
  restartedAt  DateTime?
  restartCount Int       @default(0)
  updatedAt    DateTime  @updatedAt

  @@index([status, updatedAt])
}

model SeatingLayout {
  id            String              @id @default(cuid())
  classroomId   String
  name          String
  rows          Int
  columns       Int
  configuration String              @default("{}")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  classroom     Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  assignments   SeatingAssignment[]

  @@unique([classroomId, name])
  @@index([classroomId, updatedAt])
}

model SeatingAssignment {
  id              String        @id @default(cuid())
  seatingLayoutId String
  studentId       String
  row             Int
  column          Int
  seatingLayout   SeatingLayout @relation(fields: [seatingLayoutId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([seatingLayoutId, studentId])
  @@unique([seatingLayoutId, row, column])
  @@index([studentId])
}

model AgentExecution {
  id         String    @id @default(cuid())
  agentId    String
  operation  String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?

  @@index([agentId, startedAt])
  @@index([status, startedAt])
}

/// Stores a validated mutation proposal. Its unique idempotency key prevents
/// retries from executing the same confirmed operation twice.
model PendingAction {
  id             String    @id @default(cuid())
  operation      String
  payload        String
  status         String    @default("pending")
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  executedAt     DateTime?

  @@index([status, createdAt])
}
